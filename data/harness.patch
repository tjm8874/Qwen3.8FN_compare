diff --git a/src/agents/builders/dsh.ts b/src/agents/builders/dsh.ts
new file mode 100644
index 0000000..4c6f779
--- /dev/null
+++ b/src/agents/builders/dsh.ts
@@ -0,0 +1,30 @@
+import type { AgentBuilder, AgentConfig } from '../types';
+import { BaseAgentBuilder } from '../base';
+
+export class DshAgentBuilder extends BaseAgentBuilder implements AgentBuilder {
+    constructor(agentConfig: AgentConfig) {
+        super(agentConfig);
+    }
+
+    protected getEnvironmentVariables(): Record<string, string> {
+        const home = process.env.DSH_HOME;
+        if (!home) throw new Error('Missing DSH_HOME for DeepSeek Harness');
+        return {
+            DSH_HOME: home,
+            DSH_LOCAL_API_KEY: process.env.DSH_LOCAL_API_KEY || 'local',
+            DSH_TELEMETRY_MODE: 'DISABLED',
+            DSH_PERMISSION_MODE: process.env.DSH_PERMISSION_MODE || 'workspace-write'
+        };
+    }
+
+    protected getCoreArgs(instructions: string): string[] {
+        const binary = process.env.DSH_BIN;
+        const patch = process.env.DSH_PATCH_PATH;
+        if (!binary || !patch) throw new Error('Missing DSH_BIN or DSH_PATCH_PATH for DeepSeek Harness');
+        const expected = process.env.DSH_EXPECTED_MODEL;
+        if (expected && expected !== this.config.model) {
+            throw new Error(`Harness model mismatch: expected ${expected}, got ${this.config.model}`);
+        }
+        return [binary, '--profile', 'headless', '--patch', patch, instructions];
+    }
+}
